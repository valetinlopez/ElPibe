{
  "expo": {
    "name": "ElPibe",
    "slug": "ElPibe",
    "version": "1.0.0",
    "scheme": "elpibe",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.elpibe.app",
      "infoPlist": {
        "NSCameraUsageDescription": "ElPibe necesita acceso a la cámara para grabar tus jugadas.",
        "NSMicrophoneUsageDescription": "ElPibe necesita acceso al micrófono para grabar video con audio.",
        "NSPhotoLibraryUsageDescription": "ElPibe necesita acceso a tu galería para subir videos de tus jugadas."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundColor": "#0B0E14"
      },
      "package": "com.elpibe.app",
      "permissions": [
        "CAMERA",
        "READ_MEDIA_IMAGES",
        "READ_MEDIA_VIDEO",
        "RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-image-picker",
      "expo-sqlite",
      "expo-video",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#0B0E14"
        }
      ]
    ]
  }
}
